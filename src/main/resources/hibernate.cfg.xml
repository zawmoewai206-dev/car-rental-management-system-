<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

        <!-- Database Connection -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/car_rental?useSSL=false&amp;serverTimezone=Asia/Tokyo
        </property>

        <property name="hibernate.connection.username">
            root
        </property>

        <property name="hibernate.connection.password">
        
        </property>

        <!-- SQL Dialect -->
        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL5Dialect
        </property>

        <!-- Show SQL -->
        <property name="hibernate.show_sql">
            true
        </property>

        <property name="hibernate.format_sql">
            true
        </property>

        <!-- Session -->
        <property name="hibernate.current_session_context_class">
            thread
        </property>

        <!-- Automatic Table Update -->
        <property name="hibernate.hbm2ddl.auto">
            update
        </property>

        <!-- Entity Classes -->
        <mapping class="com.rent.CarRentalManagementSystem.Entity.Car"/>
        <mapping class="com.rent.CarRentalManagementSystem.Entity.Customer"/>
        <mapping class="com.rent.CarRentalManagementSystem.Entity.Rent"/>
        <mapping class="com.rent.CarRentalManagementSystem.Entity.Maintenance"/>

    </session-factory>

</hibernate-configuration>